# ---- App ----
APP_URL=http://localhost:3000
# Signs guest order-tracking links. Never change it once live (old links would stop working).
APP_SECRET=CHANGE_ME_long_random_string

# ---- First admin (used by npm run db:seed) ----
ADMIN_EMAIL=dhruvjansari281@gmail.com
