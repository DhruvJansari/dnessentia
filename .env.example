# ---- Database ----
DATABASE_URL=mysql://dnessentia:CHANGE_ME@127.0.0.1:3306/dnessentia

# ---- App ----
APP_URL=http://localhost:3000
# Signs guest order-tracking links. Never change it once live (old links would stop working).
APP_SECRET=CHANGE_ME_long_random_string

# ---- First admin (used by npm run db:seed) ----
ADMIN_EMAIL=dhruvjansari281@gmail.com
ADMIN_PASSWORD=CHANGE_ME

# ---- SMTP (order + account emails). Leave blank to log emails instead of sending. ----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DN Essentia <support@dnessentia.com>"
ADMIN_NOTIFY_EMAIL=support@dnessentia.com

# ---- Razorpay (https://dashboard.razorpay.com/app/keys). Use rzp_test_ keys while developing. ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket (API user from Settings > API, not your main login) ----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# PIN code of that pickup address (used for the "Delivers by" check at checkout)
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_TOKEN=
# Leave blank for the live API. Set to the sandbox API base while testing with sandbox credentials.
SHIPROCKET_API_URL=
# true = "Create shipment" only creates the Shiprocket order (no courier, no pickup, no wallet charge). Use while testing a live API user.
SHIPROCKET_TEST_ONLY=false

# ---- Scheduled jobs (expire unpaid orders, payment reminders). Call /api/cron/maintenance every 15 min with this as Bearer token. ----
CRON_SECRET=CHANGE_ME_long_random_string

# ---- Google Analytics 4 (Admin → Data streams → Measurement ID, looks like G-XXXXXXX) ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Google Search Console HTML-tag verification code (content="..." value only) ----
NEXT_PUBLIC_GSC_VERIFICATION=
