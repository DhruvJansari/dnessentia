# ---- Database ----
DATABASE_URL=mysql://dnessentia:CHANGE_ME@127.0.0.1:3306/dnessentia

# ---- App ----
APP_URL=https://dnessentia.com
# Signs guest order-tracking links. Never change it once live (old links would stop working).
APP_SECRET=CHANGE_ME_long_random_string

# ---- First admin (used by npm run db:seed) ----
ADMIN_EMAIL=dhruvjansari281@gmail.com
ADMIN_PASSWORD=CHANGE_ME

# ---- SMTP (order + account emails). Leave blank to log emails instead of sending. ----
# Hostinger mailbox (dnessentia.com MX is Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@dnessentia.com
SMTP_PASS=
MAIL_FROM="DN Essentia <noreply@dnessentia.com>"
# Where customer replies go
MAIL_REPLY_TO=info@dnessentia.com
# Admin alerts (new orders, messages, replacements) go to the address in Admin → Settings → Notifications.

# ---- Razorpay (https://dashboard.razorpay.com/app/keys). rzp_live_ keys in production, rzp_test_ while developing. ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: without a webhook, paid orders are still confirmed by the 15-minute payment check.
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket (API user from Settings > API, not your main login) ----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# PIN code of that pickup address (used for the "Delivers by" check at checkout)
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_TOKEN=
# Leave blank for the live API. Set to the sandbox API base while testing with sandbox credentials.
SHIPROCKET_API_URL=
# true = "Create shipment" only creates the Shiprocket order (no courier, no pickup, no wallet charge). Use while testing a live API user.
SHIPROCKET_TEST_ONLY=false

# ---- Scheduled jobs (payment checks, reminders, unpaid-order expiry, courier tracking) ----
# The production server runs /api/cron/maintenance itself every 15 minutes using this secret.
CRON_SECRET=CHANGE_ME_long_random_string
# Set to false only if an external crontab calls /api/cron/maintenance instead.
INTERNAL_CRON=true

# ---- Google Analytics 4 (Admin → Data streams → Measurement ID, looks like G-XXXXXXX) ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Google Search Console HTML-tag verification code (content="..." value only) ----
NEXT_PUBLIC_GSC_VERIFICATION=
